# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cartunez
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your-meilisearch-api-key

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Application
APP_NAME=Cartunez API
APP_VERSION=1.0.0
DEBUG=false

# LLM providers (chatbot: OpenAI is primary, Groq is fallback)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
GROQ_API_KEY=

# Omniroute — multi-AI-provider gateway (OpenAI-compatible; used first when set)
# Point OMNIROUTE_URL at your running gateway, e.g. http://host:20128/v1
OMNIROUTE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_CHAT_MODEL=auto/claude-sonnet   # verified: clean Hinglish, fast, tool-calling
OMNIROUTE_IMAGE_MODEL=antigravity/gemini-3.1-flash-image   # image generation (verified working on this gateway)

# Instagram Reels (homepage social feed)
# Option A (automatic, recommended): official Graph API token.
#   Get one: https://developers.facebook.com/docs/instagram-platform/instagram-api-with-instagram-login/getting-started
#   Then paste the long-lived token here. Reels update automatically.
INSTAGRAM_ACCESS_TOKEN=
# Option B (manual, no token): comma-separated reel shortcodes.
#   Share a reel in the Instagram app -> "Copy link" -> paste the code part.
#   e.g. DZpunZWOoXM,DZplvOeMYtv  (takes priority over the token)
INSTAGRAM_SHORTCODES=
