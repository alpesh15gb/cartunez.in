# ==========================================
# Cartunez Medusa - Environment Variables
# ==========================================

# App
NODE_ENV=development
PORT=9000

# Database (PostgreSQL)
DATABASE_URL=postgresql://medusa:CHANGE_ME@localhost:5432/cartunez_medusa

# Redis
REDIS_URL=redis://localhost:6379

# JWT & Auth
JWT_SECRET=CHANGE_ME_minimum_32_random_characters
COOKIE_SECRET=CHANGE_ME_minimum_32_random_characters
COOKIE_SECURE=false
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
MEDUSA_PUBLIC_URL=http://localhost:9000

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your-master-key-here

# File Storage (local is the only configured provider in this phase)
FILE_STORAGE=local

# Payment and fulfillment are manual in this phase. Do not add provider keys
# until the corresponding supported Medusa v1 plugin is installed.

# Mail (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Admin
ADMIN_EMAIL=admin@cartunez.in

# ApexBooks ERP integration
APEXBOOKS_ENABLED=false
APEXBOOKS_BASE_URL=https://api.apexbooks.example
APEXBOOKS_API_KEY=
APEXBOOKS_WEBHOOK_SECRET=
APEXBOOKS_TIMEOUT_MS=10000
APEXBOOKS_MAX_RETRIES=3
APEXBOOKS_TENANT_ID=your-tenant-id

# Integration Center encryption (fallback to JWT_SECRET if not set)
INTEGRATIONS_ENCRYPTION_KEY=your-32-byte-encryption-key
