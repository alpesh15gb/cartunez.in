{
  "name": "cartunez-medusa",
  "version": "1.0.0",
  "description": "Cartunez - Automotive E-Commerce Platform powered by MedusaJS",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "ts-node --transpile-only src/index.ts",
    "dev": "npm run start:dev",
    "seed": "node seed-data.js",
    "scrape": "node scripts/scrape-neowheels.js",
    "import:wheels": "node scripts/import-neowheels.js",
    "import:neodrift": "node scripts/import-neodrift.js",
    "import:sahibacar": "node scripts/import-sahibacar.js",
    "fix:images": "node scripts/fix-product-images.js",
    "link:images": "node scripts/link-images.js",
    "map:finish-images": "node scripts/map-finish-images.js",
    "validate:images": "node scripts/validate-product-images.js",
    "verify:migration": "node scripts/verify-migration.js",
    "migrations:run": "ts-node --transpile-only node_modules/typeorm/cli.js migration:run -d src/utils/datasource.ts",
    "migrations:show": "ts-node --transpile-only node_modules/typeorm/cli.js migration:show -d src/utils/datasource.ts",
    "lint": "eslint --ext .ts src/",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:apexbooks && node tests/runtime-safety.test.js && node tests/redact-log.test.js",
    "test:apexbooks": "node tests/apexbooks-integration.test.js",
    "test:integration": "node tests/live-store.mjs",
    "smoke:store": "node ../../frontend/scripts/smoke-medusa-v1.mjs"
  },
  "dependencies": {
    "@medusajs/admin": "7.1.18",
    "@medusajs/cache-redis": "1.8.9",
    "@medusajs/event-bus-redis": "1.8.9",
    "@medusajs/file-local": "^1.0.4",
    "@medusajs/medusa": "1.20.4",
    "@medusajs/medusa-cli": "^1.3.22",
    "@medusajs/utils": "^1.11.4",
    "ajv": "^8.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.3.2",
    "medusa-fulfillment-manual": "^1.1.9",
    "medusa-interfaces": "1.3.7",
    "medusa-payment-manual": "^1.0.9",
    "medusa-plugin-meilisearch": "1.0.4",
    "meilisearch": "^0.41.0",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "typeorm": "0.3.20",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "webpack": "5.84.1",
    "webpackbar": "5.0.2",
    "medusa-interfaces": "1.3.7",
    "medusa-plugin-meilisearch": {
      "medusa-interfaces": "1.3.7"
    }
  },
  "engines": {
    "node": "20.x",
    "npm": ">=10 <11"
  },
  "keywords": [
    "medusa",
    "ecommerce",
    "automotive",
    "cartunez"
  ],
  "license": "MIT",
  "packageManager": "npm@10.8.2"
}
