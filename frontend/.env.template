# Frontend Environment Template
# Copy this file to .env.local and .env.production, then fill in actual values
# NEVER commit real secrets - only commit this template

# Server-only internal URL used by Next.js server actions and SSR.
MEDUSA_BACKEND_URL=http://localhost:9000
# Browser-safe public origin. In production this is https://cartunez.in
# (nginx proxies /store/ to Medusa on the same origin).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_REGION=in

# API Configuration
FASTAPI_BACKEND_URL=http://localhost:8005
NEXT_PUBLIC_API_URL=http://localhost:8005

# Admin Configuration (Medusa admin is served at /app or /admin on cartunez.in)
NEXT_PUBLIC_ADMIN_URL=https://cartunez.in

# Site URLs (single-domain)
NEXT_PUBLIC_BASE_URL=https://cartunez.in
NEXT_PUBLIC_STORE_URL=https://cartunez.in

# Analytics & Tracking (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx
NEXT_PUBLIC_FB_PIXEL_ID=123456789012345

# Payment is manual during this stabilization phase. Add only browser-safe
# provider identifiers after a supported provider is selected.

# Environment
NODE_ENV=production
